='11'>Controlled</text><circle cx='101' cy='179' r='4' fill='%23D97706'/><text x='109' y='183' font-family='Segoe UI' font-size='11'>Watch</text><circle cx='174' cy='179' r='4' fill='%23E11D48'/><text x='182' y='183' font-family='Segoe UI' font-size='11'>Alert</text></svg>","@Hring",IF(zoneH="E11D48","0.35","0")),"@H",zoneH),"@L",zoneL),"@Kring",IF(zoneK="E11D48","0.35","0")),"@K",zoneK),"@Bring",IF(zoneB="E11D48","0.35","0")),"@B",zoneB), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 240 190'><g text-anchor='middle' font-family='Segoe UI' font-size='12' fill='%2364748B'><text x='120' y='86'>Select a single patient via Drill-Through</text><text x='120' y='104'>or the selector above</text></g></svg>")
