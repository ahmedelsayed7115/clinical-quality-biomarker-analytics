		lineageTag: 7461678e-0bcb-4834-a36f-5180b7de314e

	measure 'Top Prescribed Drug' = VAR ranked = ADDCOLUMNS(VALUES(Fact_Medications[medication_description]), "@Rows",CALCULATE(COUNTROWS(Fact_Medications))) RETURN CONCATENATEX(TOPN(1,ranked,[@Rows],DESC,Fact_Medications[medication_description],ASC),Fact_Medications[medication_description],"")
		displayFolder: Biomarker Trajectories
		lineageTag: e7594509-eeaf-41df-8332-da0de4dffc0a

