table _Measures
	lineageTag: c2769718-9cc6-547d-b0b6-f1e10ee81a1a

	/// Distinct patients in the selected demographic cohort.
	measure 'Total Cohort Patients' = DISTINCTCOUNT(Dim_Patients[patient_id])
		formatString: #,##0
		displayFolder: Cohort
		lineageTag: 5e922662-a6b7-5d8d-9019-18e751906369

	/// Share of the selected cohort with a recorded death date. This is a cohort snapshot.
	measure 'Cohort Mortality Rate (%)' =
			VAR CohortSize = [Total Cohort Patients]
			VAR PatientsWithDeathDate =
			    CALCULATE(
			        [Total Cohort Patients],
			        KEEPFILTERS(NOT ISBLANK(Dim_Patients[DEATHDATE]))
			    )
			RETURN DIVIDE(COALESCE(PatientsWithDeathDate, 0), CohortSize)
		formatString: 0.00%
		displayFolder: Cohort
		lineageTag: 02efffce-f388-57cf-9711-046eff279bcb

	/// Share of the selected cohort in the source Polypharmacy Risk tier (5+ active medications).
	measure 'Polypharmacy Rate (%)' =
			VAR CohortSize = [Total Cohort Patients]
			VAR PatientsWithFiveOrMore =
			    CALCULATE(
			        [Total Cohort Patients],
			        KEEPFILTERS(Dim_Patients[polypharmacy_tier] = "Polypharmacy Risk")
			    )
			RETURN DIVIDE(COALESCE(PatientsWithFiveOrMore, 0), CohortSize)
		formatString: 0.00%
		displayFolder: Cohort
		lineageTag: aff35385-6866-531d-8265-514fb64498ae

	/// Most recent dated nonblank reading in the current context. Apply to one patient at a time.
	measure 'Latest Patient Systolic BP' =
			VAR LatestVisit =
			    TOPN(
			        1,
			        FILTER(
			            Fact_Vitals,
			            NOT ISBLANK(Fact_Vitals[visit_date])
			                && NOT ISBLANK(Fact_Vitals[systolic_bp])
			        ),
			        Fact_Vitals[visit_date], DESC,
			        Fact_Vitals[visit_sequence_num], DESC,
			        Fact_Vitals[encounter_id], DESC
			    )
			RETURN MAXX(LatestVisit, Fact_Vitals[systolic_bp])
		isHidden
		displayFolder: Latest Readings
		lineageTag: 53a954fb-2621-5e5e-a692-a085a54ba0c3

	/// Most recent dated nonblank reading in the current context. Apply to one patient at a time.
	measure 'Latest Patient Diastolic BP' =
			VAR LatestVisit =
			    TOPN(
			        1,
			        FILTER(
			            Fact_Vitals,
			            NOT ISBLANK(Fact_Vitals[visit_date])
			                && NOT ISBLANK(Fact_Vitals[diastolic_bp])
			        ),
			        Fact_Vitals[visit_date], DESC,
			        Fact_Vitals[visit_sequence_num], DESC,
			        Fact_Vitals[encounter_id], DESC
			    )
			RETURN MAXX(LatestVisit, Fact_Vitals[diastolic_bp])
		isHidden
		displayFolder: Latest Readings
		lineageTag: 0dcec123-12c0-5c09-a6ee-cd2fe0246b06

	/// Most recent dated nonblank reading in the current context. Apply to one patient at a time.
	measure 'Latest Patient BMI' =
			VAR LatestVisit =
			    TOPN(
			        1,
			        FILTER(
			            Fact_Vitals,
			            NOT ISBLANK(Fact_Vitals[visit_date])
			                && NOT ISBLANK(Fact_Vitals[bmi])
			        ),
			        Fact_Vitals[visit_date], DESC,
			        Fact_Vitals[visit_sequence_num], DESC,
			        Fact_Vitals[encounter_id], DESC
			    )
			RETURN MAXX(LatestVisit, Fact_Vitals[bmi])
		isHidden
		displayFolder: Latest Readings
		lineageTag: a76a7444-c81f-5ebd-b879-4d34168b7ff1

	/// Most recent dated nonblank reading in the current context. Apply to one patient at a time.
	measure 'Latest Patient QALY' =
			VAR LatestVisit =
			    TOPN(
			        1,
			        FILTER(
			            Fact_Vitals,
			            NOT ISBLANK(Fact_Vitals[visit_date])
			                && NOT ISBLANK(Fact_Vitals[qaly])
			        ),
			        Fact_Vitals[visit_date], DESC,
			        Fact_Vitals[visit_sequence_num], DESC,
			        Fact_Vitals[encounter_id], DESC
			    )
			RETURN MAXX(LatestVisit, Fact_Vitals[qaly])
		isHidden
		displayFolder: Latest Readings
		lineageTag: 6d2d7b92-14b0-5c5f-868c-ec29d8e5a9bf

	/// Share of flagged patients with both readings whose latest systolic and diastolic readings are below 130 and 80, respectively.
	measure 'Hypertension Control Rate (%)' =
			VAR HypertensivePatients =
			    CALCULATETABLE(
			        DISTINCT(Dim_Patients[patient_id]),
			        KEEPFILTERS(Dim_Patients[has_hypertension] = 1)
			    )
			VAR LatestBP =
			    ADDCOLUMNS(
			        HypertensivePatients,
			        "@Systolic", [Latest Patient Systolic BP],
			        "@Diastolic", [Latest Patient Diastolic BP]
			    )
			VAR PatientsWithBothReadings =
			    FILTER(LatestBP, NOT ISBLANK([@Systolic]) && NOT ISBLANK([@Diastolic]))
			VAR Controlled =
			    FILTER(PatientsWithBothReadings, [@Systolic] < 130 && [@Diastolic] < 80)
			RETURN DIVIDE(COALESCE(COUNTROWS(Controlled), 0), COUNTROWS(PatientsWithBothReadings))
		formatString: 0.00%
		displayFolder: Clinical Control
		lineageTag: 88454712-f035-5b46-aa85-29cd4ae1a845

	/// Share of patients with a dated BMI reading whose latest BMI is at least 30.
	measure 'Obesity Prevalence (%)' =
			VAR LatestBMI =
			    ADDCOLUMNS(DISTINCT(Dim_Patients[patient_id]), "@BMI", [Latest Patient BMI])
			VAR PatientsWithBMI = FILTER(LatestBMI, NOT ISBLANK([@BMI]))
			VAR PatientsWithObesity = FILTER(PatientsWithBMI, [@BMI] >= 30)
			RETURN DIVIDE(COALESCE(COUNTROWS(PatientsWithObesity), 0), COUNTROWS(PatientsWithBMI))
		formatString: 0.00%
		displayFolder: Clinical Control
		lineageTag: bb2c577d-d419-514c-bad5-e5a0d5ab815d

	/// Mean of each patient’s latest dated QALY, with equal weight per patient and blank scores skipped.
	measure 'Average Quality of Life (QALY)' = AVERAGEX(DISTINCT(Dim_Patients[patient_id]), [Latest Patient QALY])
		formatString: #,##0.00
		displayFolder: Clinical Control
		lineageTag: 3f589c49-db01-5ab3-8019-c375873ce9b0

	/// Mean of dated nonblank readings in the current filter context. Each reading has equal weight.
	measure 'Average Systolic BP Reading' =
			CALCULATE(
			    AVERAGE(Fact_Vitals[systolic_bp]),
			    KEEPFILTERS(NOT ISBLANK(Fact_Vitals[visit_date]))
			)
		formatString: #,##0.00
		displayFolder: Biomarker Averages
		lineageTag: a12ed93f-70d9-52ac-b853-e5f4b64f11db

	/// Mean of dated nonblank readings in the current filter context. Each reading has equal weight.
	measure 'Average Diastolic BP Reading' =
			CALCULATE(
			    AVERAGE(Fact_Vitals[diastolic_bp]),
			    KEEPFILTERS(NOT ISBLANK(Fact_Vitals[visit_date]))
			)
		formatString: #,##0.00
		displayFolder: Biomarker Averages
		lineageTag: 5e57096b-d9f5-54f2-802b-b9f875dcc7c4

	/// Mean of dated nonblank readings in the current filter context. Each reading has equal weight.
	measure 'Average BMI Reading' =
			CALCULATE(
			    AVERAGE(Fact_Vitals[bmi]),
			    KEEPFILTERS(NOT ISBLANK(Fact_Vitals[visit_date]))
			)
		formatString: #,##0.00
		displayFolder: Biomarker Averages
		lineageTag: 7bad0aad-6a02-50d3-8bfb-792f124bfd89

	/// Mean of dated nonblank readings in the current filter context. Each reading has equal weight.
	measure 'Average Heart Rate Reading' =
			CALCULATE(
			    AVERAGE(Fact_Vitals[heart_rate]),
			    KEEPFILTERS(NOT ISBLANK(Fact_Vitals[visit_date]))
			)
		formatString: #,##0.00
		displayFolder: Biomarker Averages
		lineageTag: ea474d7b-ee1a-5cad-84c3-46d25a9522bf

	/// Mean of dated nonblank readings in the current filter context. Each reading has equal weight.
	measure 'Average Creatinine Reading' =
			CALCULATE(
			    AVERAGE(Fact_Vitals[creatinine]),
			    KEEPFILTERS(NOT ISBLANK(Fact_Vitals[visit_date]))
			)
		formatString: #,##0.00
		displayFolder: Biomarker Averages
		lineageTag: bf8115eb-d914-5d41-8b55-7ca64afc0da7

	/// Mean of dated nonblank readings in the current filter context. Each reading has equal weight.
	measure 'Average QALY Reading' =
			CALCULATE(
			    AVERAGE(Fact_Vitals[qaly]),
			    KEEPFILTERS(NOT ISBLANK(Fact_Vitals[visit_date]))
			)
		formatString: #,##0.00
		displayFolder: Biomarker Averages
		lineageTag: 8aa37371-fd70-5f3b-9675-fb7c5ecad0ce

	/// Mean paired patient change (post minus pre). Uses readings before the first selected therapy and from day 90 onward.
	measure 'Systolic BP Change After Therapy (90+ Days)' =
			AVERAGEX(
			    DISTINCT(Dim_Patients[patient_id]),
			    VAR TherapyStartInPeriod =
			        CALCULATE(MIN(Fact_Medications[therapy_start_date]))
			    VAR FirstTherapyStart =
			        CALCULATE(MIN(Fact_Medications[therapy_start_date]), REMOVEFILTERS(Dim_Date))
			    RETURN
			        IF(
			            NOT ISBLANK(FirstTherapyStart) && FirstTherapyStart = TherapyStartInPeriod,
			            VAR BeforeTherapy =
			                CALCULATE(
			                    CALCULATE(
			                        AVERAGE(Fact_Vitals[systolic_bp]),
			                        KEEPFILTERS(NOT ISBLANK(Fact_Vitals[visit_date])),
			                        KEEPFILTERS(Fact_Vitals[visit_date] < FirstTherapyStart)
			                    ),
			                    REMOVEFILTERS(Dim_Date)
			                )
			            VAR AfterTherapy =
			                CALCULATE(
			                    CALCULATE(
			                        AVERAGE(Fact_Vitals[systolic_bp]),
			                        KEEPFILTERS(Fact_Vitals[visit_date] >= FirstTherapyStart + 90)
			                    ),
			                    REMOVEFILTERS(Dim_Date)
			                )
			            RETURN
			                IF(
			                    NOT ISBLANK(BeforeTherapy) && NOT ISBLANK(AfterTherapy),
			                    AfterTherapy - BeforeTherapy
			                )
			        )
			)
		formatString: +0.00;-0.00;0.00
		displayFolder: Treatment Follow-up
		lineageTag: 789aff2d-52f6-5543-9476-9704373f3105

	/// Mean paired patient change (post minus pre). Uses readings before the first selected therapy and from day 90 onward.
	measure 'BMI Change After Therapy (90+ Days)' =
			AVERAGEX(
			    DISTINCT(Dim_Patients[patient_id]),
			    VAR TherapyStartInPeriod =
			        CALCULATE(MIN(Fact_Medications[therapy_start_date]))
			    VAR FirstTherapyStart =
			        CALCULATE(MIN(Fact_Medications[therapy_start_date]), REMOVEFILTERS(Dim_Date))
			    RETURN
			        IF(
			            NOT ISBLANK(FirstTherapyStart) && FirstTherapyStart = TherapyStartInPeriod,
			            VAR BeforeTherapy =
			                CALCULATE(
			                    CALCULATE(
			                        AVERAGE(Fact_Vitals[bmi]),
			                        KEEPFILTERS(NOT ISBLANK(Fact_Vitals[visit_date])),
			                        KEEPFILTERS(Fact_Vitals[visit_date] < FirstTherapyStart)
			                    ),
			                    REMOVEFILTERS(Dim_Date)
			                )
			            VAR AfterTherapy =
			                CALCULATE(
			                    CALCULATE(
			                        AVERAGE(Fact_Vitals[bmi]),
			                        KEEPFILTERS(Fact_Vitals[visit_date] >= FirstTherapyStart + 90)
			                    ),
			                    REMOVEFILTERS(Dim_Date)
			                )
			            RETURN
			                IF(
			                    NOT ISBLANK(BeforeTherapy) && NOT ISBLANK(AfterTherapy),
			                    AfterTherapy - BeforeTherapy
			                )
			        )
			)
		formatString: +0.00;-0.00;0.00
		displayFolder: Treatment Follow-up
		lineageTag: 44e1bd93-1d39-5fd5-9578-7b6625e5abe8

	/// Mean paired patient change (post minus pre). Uses readings before the first selected therapy and from day 90 onward.
	measure 'Creatinine Change After Therapy (90+ Days)' =
			AVERAGEX(
			    DISTINCT(Dim_Patients[patient_id]),
			    VAR TherapyStartInPeriod =
			        CALCULATE(MIN(Fact_Medications[therapy_start_date]))
			    VAR FirstTherapyStart =
			        CALCULATE(MIN(Fact_Medications[therapy_start_date]), REMOVEFILTERS(Dim_Date))
			    RETURN
			        IF(
			            NOT ISBLANK(FirstTherapyStart) && FirstTherapyStart = TherapyStartInPeriod,
			            VAR BeforeTherapy =
			                CALCULATE(
			                    CALCULATE(
			                        AVERAGE(Fact_Vitals[creatinine]),
			                        KEEPFILTERS(NOT ISBLANK(Fact_Vitals[visit_date])),
			                        KEEPFILTERS(Fact_Vitals[visit_date] < FirstTherapyStart)
			                    ),
			                    REMOVEFILTERS(Dim_Date)
			                )
			            VAR AfterTherapy =
			                CALCULATE(
			                    CALCULATE(
			                        AVERAGE(Fact_Vitals[creatinine]),
			                        KEEPFILTERS(Fact_Vitals[visit_date] >= FirstTherapyStart + 90)
			                    ),
			                    REMOVEFILTERS(Dim_Date)
			                )
			            RETURN
			                IF(
			                    NOT ISBLANK(BeforeTherapy) && NOT ISBLANK(AfterTherapy),
			                    AfterTherapy - BeforeTherapy
			                )
			        )
			)
		formatString: +0.00;-0.00;0.00
		displayFolder: Treatment Follow-up
		lineageTag: 73477581-62fc-5da6-ab81-79d68157fa64

	measure 'Dynamic Biomarker Target' = SWITCH(SELECTEDVALUE('Biomarker Selector'[Biomarker Selector Order], 0), 0, 130, 1, 80, 2, 30, 3, 100, 4, 1.3)
		displayFolder: Population Control
		lineageTag: b07279b6-0836-4c7e-acd5-8aeb93f0a5a5

	measure 'Selected Biomarker Average' = SWITCH(SELECTEDVALUE('Biomarker Selector'[Biomarker Selector Order], 0), 0, [Average Systolic BP Reading], 1, [Average Diastolic BP Reading], 2, [Average BMI Reading], 3, [Average Heart Rate Reading], 4, [Average Creatinine Reading])
		displayFolder: Population Control
		lineageTag: ae0b7f22-c3ab-45ac-bad4-c903f2b2bbf0

	measure 'Biomarker Chart Subtitle' = VAR u = SWITCH(SELECTEDVALUE('Biomarker Selector'[Biomarker Selector Order], 0), 0, "mmHg", 1, "mmHg", 2, "kg/m²", 3, "bpm", 4, "mg/dL") RETURN "Cohort Avg: " & FORMAT([Selected Biomarker Average],"0.00") & " " & u & " • Dashed line marks clinical target < " & FORMAT([Dynamic Biomarker Target],"0.#") & " " & u
		displayFolder: Population Control
		lineageTag: 90f9deeb-1334-42a0-bd29-0cbcfdd6eeac

	measure 'BMI Eligible Count' = COALESCE(COUNTROWS(FILTER(VALUES(Dim_Patients[patient_id]), NOT ISBLANK([Latest Patient BMI]))),0)
		displayFolder: Population Control
		lineageTag: 7fbdb48b-fe06-4af8-9a1a-0b2c18c5d316

	measure 'HTN Eligible Count' = COALESCE(COUNTROWS(FILTER(CALCULATETABLE(VALUES(Dim_Patients[patient_id]), KEEPFILTERS(Dim_Patients[has_hypertension]=1)), NOT ISBLANK([Latest Patient Systolic BP]) && NOT ISBLANK([Latest Patient Diastolic BP]))),0)
		displayFolder: Population Control
		lineageTag: 81cfd8ea-e237-43a2-a5b2-fa9c635b948b

	measure 'Cohort Detail' = FORMAT([BMI Eligible Count], "#,##0") & " w/ BMI • " & FORMAT(CALCULATE([Total Cohort Patients], KEEPFILTERS(Dim_Patients[has_hypertension]=1))+0, "#,##0") & " Hypertensive"
		displayFolder: Population Control
		lineageTag: c377f3b8-9c92-4098-9963-880b3e758974

	measure 'Control Detail' = FORMAT(COALESCE([Hypertension Control Rate (%)]*[HTN Eligible Count],0), "#,##0") & " / " & FORMAT([HTN Eligible Count], "#,##0") & " controlled (<130/80 mmHg)"
		displayFolder: Population Control
		lineageTag: 9fd61e3d-977d-4625-8ca5-067c969086ab

	measure 'Obesity Detail' = FORMAT(COALESCE([Obesity Prevalence (%)]*[BMI Eligible Count],0), "#,##0") & " / " & FORMAT([BMI Eligible Count], "#,##0") & " patients (BMI ≥ 30)"
		displayFolder: Population Control
		lineageTag: b52b0b4e-66d8-430c-a3e4-453b15087729

	measure 'Medication Detail' = FORMAT(COALESCE([Polypharmacy Rate (%)]*[Total Cohort Patients],0), "#,##0") & " patients on 5+ active meds"
		displayFolder: Population Control
		lineageTag: d530a42c-999d-4622-9976-c9814a85e2aa

	measure 'Mortality Detail' = VAR d = ROUND([Cohort Mortality Rate (%)]*[Total Cohort Patients],0) RETURN FORMAT(d+0, "#,##0") & " deceased • " & FORMAT([Total Cohort Patients]-d, "#,##0") & " active"
		displayFolder: Population Control
		lineageTag: 99224212-4b5c-42e1-a23d-a311ea58e3d2

	measure 'Control Value Color' = IF(ISBLANK([Hypertension Control Rate (%)]),"#94A3B8",IF([Hypertension Control Rate (%)]>=0.5,"#0D9488","#E11D48"))
		displayFolder: Population Control
		lineageTag: 6b3aa058-57cc-47cd-8aed-b8f5705f4ee4

	measure 'Percent of Age Cohort' = DIVIDE([Total Cohort Patients], CALCULATE([Total Cohort Patients], ALLSELECTED(Dim_Patients[polypharmacy_tier])))
		formatString: 0.0%
		displayFolder: Population Control
		lineageTag: 57d684a6-d965-4066-8da1-b0d4a6402422

	measure 'Patient Summary' = FORMAT([Total Cohort Patients], "#,##0") & " patients  •  BP " & FORMAT(AVERAGEX(VALUES(Dim_Patients[patient_id]),[Latest Patient Systolic BP]),"0") & "/" & FORMAT(AVERAGEX(VALUES(Dim_Patients[patient_id]),[Latest Patient Diastolic BP]),"0") & " mmHg  •  BMI " & FORMAT(AVERAGEX(VALUES(Dim_Patients[patient_id]),[Latest Patient BMI]),"0.0")
		displayFolder: Population Control
		lineageTag: 3658085f-aaf1-4cbd-93ee-3563a3668a30

	measure 'Anatomy Preview' =
			VAR s = AVERAGEX(VALUES(Dim_Patients[patient_id]),[Latest Patient Systolic BP])
			VAR d = AVERAGEX(VALUES(Dim_Patients[patient_id]),[Latest Patient Diastolic BP])
			VAR b = AVERAGEX(VALUES(Dim_Patients[patient_id]),[Latest Patient BMI])
			VAR c = [Average Creatinine Reading]
			VAR lung = AVERAGE(Dim_Patients[has_asthma_copd])
			VAR heart = SWITCH(TRUE(),ISBLANK(s)||ISBLANK(d),"94A3B8",s>=130||d>=80,"E11D48","0D9488")
			VAR lungs = SWITCH(TRUE(),ISBLANK(lung),"94A3B8",lung=1,"E11D48",lung>0,"D97706","0D9488")
			VAR kidney = SWITCH(TRUE(),ISBLANK(c),"94A3B8",c>=1.3,"E11D48","0D9488")
			VAR torso = SWITCH(TRUE(),ISBLANK(b),"94A3B8",b>=30,"E11D48",b>=25,"D97706","0D9488")
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 70 110'><g fill='%23475569'><circle cx='35' cy='10' r='8'/><path d='M27 20Q17 20 16 29L8 57Q8 63 13 60L23 37L23 60L21 104Q23 110 28 105L35 68L42 105Q47 110 49 104L47 60L47 37L57 60Q62 63 62 57L54 29Q53 20 43 20Z'/></g><ellipse cx='35' cy='51' rx='9' ry='12' fill='%23" & torso & "'/><g fill='%23" & lungs & "'><ellipse cx='29' cy='34' rx='5' ry='8'/><ellipse cx='41' cy='34' rx='5' ry='8'/></g><path d='M34 35Q35 31 38 34Q42 31 42 36L38 41Z' fill='%23" & heart & "'/><g fill='%23" & kidney & "'><ellipse cx='29' cy='49' rx='3' ry='5'/><ellipse cx='41' cy='49' rx='3' ry='5'/></g></svg>"
		displayFolder: Population Control
		lineageTag: f25b503f-1bb2-47ad-96c1-45d28dc15587
		dataCategory: ImageUrl

	measure 'Systolic BP Paired Patients' = COALESCE(COUNTX(VALUES(Dim_Patients[patient_id]), [Systolic BP Change After Therapy (90+ Days)]),0)
		formatString: #,##0
		displayFolder: Biomarker Trajectories
		lineageTag: 9567371b-9c19-4abe-ab28-721c997b8ca7

	measure 'Systolic BP Shift Display' = IF(ISBLANK([Systolic BP Change After Therapy (90+ Days)]), "—", FORMAT([Systolic BP Change After Therapy (90+ Days)], "+0.00;-0.00;0.00") & " mmHg")
		displayFolder: Biomarker Trajectories
		lineageTag: 57223176-15b0-4b45-84dc-dc2dc8377db1

	measure 'Systolic BP Shift Detail' = "n = " & FORMAT([Systolic BP Paired Patients], "#,##0") & " • Near-Flat Stabilization"
		displayFolder: Biomarker Trajectories
		lineageTag: a9569e7c-cb86-4435-8cb1-104af2537077

	measure 'BMI Paired Patients' = COALESCE(COUNTX(VALUES(Dim_Patients[patient_id]), [BMI Change After Therapy (90+ Days)]),0)
		formatString: #,##0
		displayFolder: Biomarker Trajectories
		lineageTag: 64b13328-5740-4ef4-8759-7637658e7e5b

	measure 'BMI Shift Display' = IF(ISBLANK([BMI Change After Therapy (90+ Days)]), "—", FORMAT([BMI Change After Therapy (90+ Days)], "+0.00;-0.00;0.00") & " kg/m²")
		displayFolder: Biomarker Trajectories
		lineageTag: 00b62266-7017-4b8a-8b53-5eacc2ba60ad

	measure 'BMI Shift Detail' = "n = " & FORMAT([BMI Paired Patients], "#,##0") & " • Gradual Drift"
		displayFolder: Biomarker Trajectories
		lineageTag: 95876465-da47-40e5-8341-0b9a3aa79d86

	measure 'Creatinine Paired Patients' = COALESCE(COUNTX(VALUES(Dim_Patients[patient_id]), [Creatinine Change After Therapy (90+ Days)]),0)
		formatString: #,##0
		displayFolder: Biomarker Trajectories
		lineageTag: cd76d566-567d-4d50-a8b1-7a69fac11d64

	measure 'Creatinine Shift Display' = IF(ISBLANK([Creatinine Change After Therapy (90+ Days)]), "—", FORMAT([Creatinine Change After Therapy (90+ Days)], "+0.00;-0.00;0.00") & " mg/dL")
		displayFolder: Biomarker Trajectories
		lineageTag: 5cceb0a6-16b9-456a-92f3-b6660180ffa0

	measure 'Creatinine Shift Detail' = "n = " & FORMAT([Creatinine Paired Patients], "#,##0") & " • Renal Watch"
		displayFolder: Biomarker Trajectories
		lineageTag: bfc59577-9dd3-4c2e-917f-120ed8cf1831

	measure 'Selected Biomarker 90+ Day Therapy Change' = SWITCH(SELECTEDVALUE('Biomarker Selector'[Biomarker Selector Order],0),2,[BMI Change After Therapy (90+ Days)],4,[Creatinine Change After Therapy (90+ Days)],[Systolic BP Change After Therapy (90+ Days)])
		formatString: +#,0.00;-#,0.00;0.00
		displayFolder: Biomarker Trajectories
		lineageTag: 03733339-b471-44ec-abab-2a771d5a5d20

	measure 'Selected Therapy Paired Patients' = SWITCH(SELECTEDVALUE('Biomarker Selector'[Biomarker Selector Order],0),2,[BMI Paired Patients],4,[Creatinine Paired Patients],[Systolic BP Paired Patients])
		formatString: #,##0
		displayFolder: Biomarker Trajectories
		lineageTag: ba6c449d-c316-4d18-8d20-b2e618309d66

	measure 'Therapy Change Bar Color' = VAR v = [Selected Biomarker 90+ Day Therapy Change] RETURN SWITCH(TRUE(),ISBLANK(v),"#94A3B8",v<0,"#0D9488",v<=1.5,"#D97706","#E11D48")
		displayFolder: Biomarker Trajectories
		lineageTag: 2e025a53-11e7-4d37-998d-4e4a4634e019

	measure 'Therapy Shift Axis Label' = SWITCH(SELECTEDVALUE('Biomarker Selector'[Biomarker Selector Order],0), 1,"Systolic BP shift (mmHg) • Diastolic BP fallback", 3,"Systolic BP shift (mmHg) • Heart Rate fallback", 2,"BMI shift (kg/m²)", 4,"Creatinine shift (mg/dL)", "Systolic BP shift (mmHg)")
		displayFolder: Biomarker Trajectories
		lineageTag: ef42b4c8-4821-4f76-a51f-7d2817702402

	measure 'Distinct Patients on Therapy' = DISTINCTCOUNT(Fact_Medications[patient_id])
		formatString: #,##0
		displayFolder: Biomarker Trajectories
		lineageTag: df4c21ac-1196-452b-b4c5-d36459412159

	measure 'Average Dispenses' = AVERAGE(Fact_Medications[total_dispenses])
		formatString: 0.0
		displayFolder: Biomarker Trajectories
		lineageTag: 69cf5e1b-1e58-4aa1-a867-2b8459363081

	measure 'Patient Coverage and Refill Label' = IF(NOT ISBLANK([Distinct Patients on Therapy]),FORMAT([Distinct Patients on Therapy],"#,##0") & " patients • avg " & FORMAT([Average Dispenses],"0.0") & " dispenses")
		displayFolder: Biomarker Trajectories
		lineageTag: 3554317b-8c75-4bd4-af3e-fc59d6d61d82

	measure 'Active Regimen Rate (%)' = DIVIDE(CALCULATE(COUNTROWS(Fact_Medications), KEEPFILTERS(ISBLANK(Fact_Medications[therapy_stop_date])))+0, COUNTROWS(Fact_Medications))
		formatString: 0.0%
		displayFolder: Biomarker Trajectories
		lineageTag: dc25fef6-64ae-4988-9c99-dda370ff67b0

	measure 'Total Cumulative Dispenses' = SUM(Fact_Medications[total_dispenses])
