	column 'Age Cohort Order' = SWITCH(TRUE(), Dim_Patients[age]<18, 1, Dim_Patients[age]<45, 2, Dim_Patients[age]<65, 3, 4)
		isHidden
		lineageTag: 1b9a7439-aabe-442d-80f9-f0b6919616fd
		summarizeBy: none

	partition Dim_Patients = m
		mode: import
		source =
				let
				    Folder = Text.Trim(CSVFolder),
				    Contents =
				        if Folder = "Use included CSVs" or Folder = "" then
				            Binary.Decompress(
				                Binary.FromText(
				                    Text.Combine({
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        ""
				                    }),
				                    BinaryEncoding.Base64
				                ),
				                Compression.Deflate
				            )
				        else
				            File.Contents(Text.TrimEnd(Folder, {"\", "/"}) & "\Dim_Patients.csv"),
				    Source = Csv.Document(Contents, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    NormalizeBlanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(NormalizeBlanks, {
				        {"patient_id", type text},
				        {"GENDER", type text},
				        {"RACE", type text},
				        {"ETHNICITY", type text},
				        {"CITY", type text},
				        {"ZIP", type text},
				        {"BIRTHDATE", type date},
				        {"DEATHDATE", type date},
				        {"age", Int64.Type},
				        {"age_cohort", type text},
				        {"vital_status", type text},
				        {"has_obesity", Int64.Type},
				        {"has_hypertension", Int64.Type},
				        {"has_diabetes", Int64.Type},
				        {"has_hyperlipidemia", Int64.Type},
				        {"has_asthma_copd", Int64.Type},
				        {"has_oncology", Int64.Type},
				        {"active_med_count", Int64.Type},
				        {"polypharmacy_tier", type text}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

