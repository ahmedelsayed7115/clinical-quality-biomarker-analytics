table Fact_Medications
	lineageTag: 0d308211-a446-5abd-bbd2-dee88eab9ac6

	column patient_id
		dataType: string
		isHidden
		lineageTag: 20bf804d-fa23-5489-90ee-4f396c2b29f4
		summarizeBy: none
		sourceColumn: patient_id

	column medication_code
		dataType: string
		lineageTag: 963aeff5-2331-50da-ace8-149893dc3f66
		summarizeBy: none
		sourceColumn: medication_code

	column medication_description
		dataType: string
		lineageTag: 48385756-37d2-5926-bd38-1b95dd2b3e30
		summarizeBy: none
		sourceColumn: medication_description

	column therapeutic_class
		dataType: string
		lineageTag: 1f1d95b6-b41e-5873-8a96-808172e6c318
		summarizeBy: none
		sourceColumn: therapeutic_class

	column therapy_start_date
		dataType: dateTime
		isHidden
		formatString: yyyy-MM-dd
		lineageTag: f9a98a4b-4181-578c-985c-3afbdd74a99d
		summarizeBy: none
		sourceColumn: therapy_start_date

		annotation UnderlyingDateTimeDataType = Date

	column therapy_stop_date
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 80f94636-3ad7-545e-9c87-6128c4d8fc0c
		summarizeBy: none
