		summarizeBy: none
		sourceColumn: out_of_pocket_cost

	column 'Regimen Sort' = IF(ISBLANK(Fact_Medications[therapy_stop_date]),0,1)
		isHidden
		lineageTag: 4dced063-e164-4efa-8e17-8df9ccf57cff

	column 'Regimen Status' = IF(ISBLANK(Fact_Medications[therapy_stop_date]),"● Active","○ Stopped")
		lineageTag: 4874febe-2fce-437b-ac65-8cb82ae6c458
		summarizeBy: none
		sortByColumn: 'Regimen Sort'

	column 'Therapy Period' = FORMAT(Fact_Medications[therapy_start_date],"MMM yyyy") & " – " & IF(ISBLANK(Fact_Medications[therapy_stop_date]),"Present",FORMAT(Fact_Medications[therapy_stop_date],"MMM yyyy"))
		lineageTag: eff0b0e3-54b2-4441-a239-8c6dace6411b
		summarizeBy: none

	partition Fact_Medications = m
		mode: import
		source =
				let
				    Folder = Text.Trim(CSVFolder),
				    Contents =
				        if Folder = "Use included CSVs" or Folder = "" then
				            Binary.Decompress(
				                Binary.FromText(
				                    Text.Combine({
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        ""
				                    }),
				                    BinaryEncoding.Base64
				                ),
				                Compression.Deflate
				            )
				        else
				            File.Contents(Text.TrimEnd(Folder, {"\", "/"}) & "\Fact_Medications.csv"),
				    Source = Csv.Document(Contents, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    NormalizeBlanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(NormalizeBlanks, {
				        {"patient_id", type text},
				        {"medication_code", type text},
				        {"medication_description", type text},
				        {"therapeutic_class", type text},
				        {"therapy_start_date", type date},
				        {"therapy_stop_date", type date},
				        {"is_active_therapy", Int64.Type},
				        {"total_dispenses", Int64.Type},
				        {"total_cost", type number},
				        {"total_payer_coverage", type number},
				        {"out_of_pocket_cost", type number}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

