		annotation UnderlyingDateTimeDataType = Date

	column is_active_therapy
		dataType: int64
		lineageTag: 94a06d65-9e8a-5000-8f64-f78c72251bb5
		summarizeBy: none
		sourceColumn: is_active_therapy

	column total_dispenses
		dataType: int64
		lineageTag: 516769fc-96d5-51db-807a-4155a60f699f
		summarizeBy: none
		sourceColumn: total_dispenses

	column total_cost
		dataType: double
		lineageTag: 8a42f182-67eb-5846-9fe7-8ad0bdcf4b1c
		summarizeBy: none
