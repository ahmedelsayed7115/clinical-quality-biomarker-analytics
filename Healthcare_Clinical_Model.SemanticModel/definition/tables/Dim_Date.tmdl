table Dim_Date
	lineageTag: b8a5b298-352a-5877-838b-112c4d21e783
	dataCategory: Time

	column date
		dataType: dateTime
		isKey
		formatString: yyyy-MM-dd
		lineageTag: 37f29f7d-5668-568d-bf0a-594018de5087
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		lineageTag: 004844a9-fe53-5f91-a75a-58b630a2a745
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: int64
		lineageTag: 8364c321-6083-542e-b844-ed6f46c6f8ab
		summarizeBy: none
		sourceColumn: quarter

	column month_num
		dataType: int64
		lineageTag: f54dfe80-c509-5d61-8491-f2dfed21d773
		summarizeBy: none
		sourceColumn: month_num

	column month_name
		dataType: string
		lineageTag: 1838fbea-1be4-553d-b173-82df686a8637
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_num

	column year_month
		dataType: string
		lineageTag: 7db9be91-cc48-57f5-aa31-969d57ebf3a8
		summarizeBy: none
		sourceColumn: year_month

	partition Dim_Date = m
		mode: import
		source =
				let
				    Folder = Text.Trim(CSVFolder),
				    Contents =
				        if Folder = "Use included CSVs" or Folder = "" then
				            Binary.Decompress(
				                Binary.FromText(
				                    Text.Combine({
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        "",
				                        ""
				                    }),
				                    BinaryEncoding.Base64
				                ),
				                Compression.Deflate
				            )
				        else
				            File.Contents(Text.TrimEnd(Folder, {"\", "/"}) & "\Dim_Date.csv"),
				    Source = Csv.Document(Contents, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    NormalizeBlanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(NormalizeBlanks, {
				        {"date", type date},
				        {"year", Int64.Type},
				        {"quarter", Int64.Type},
				        {"month_num", Int64.Type},
				        {"month_name", type text},
				        {"year_month", type text}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

